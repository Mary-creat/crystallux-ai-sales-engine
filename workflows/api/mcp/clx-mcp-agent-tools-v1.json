      "id": "mat-0001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        200,
        500
      ],
      "webhookId": "clx-mcp-agent-tools-001",
      "notes": "DEACTIVATED. Internal-call (INTERNAL_EMAIL_SECRET — system-level, not session). Write-tool MCP gateway — extends the existing read-only clx-mcp-tool-gateway with the action tools the AI Agent needs. Each tool wraps an underlying workflow. Logs every invocation to mcp_tool_calls. Claude (in C1 decision engine, future) can call this with { tool_name, tool_input } to take real actions: place_outbound_call, send_whatsapp, send_sms, send_email, generate_video, book_meeting, update_lead_status, log_decision, retrieve_lead_memory, escalate_to_human."
    },
    {
      "parameters": {
        "jsCode": "// MCP entry: authenticate, then establish context. Fail-closed throughout.\n//\n// This node does AUTHORIZATION (who is asking, for which tenant, with what\n// entitlement). It deliberately does NOT decide APPROVAL -- the five\n// contact-a-human tools are routed to agent/action-execute, whose Policy Gate\n// owns that decision. One policy, one place.\n\nconst body = ($input.item.json && $input.item.json.body) || $input.item.json || {};\nconst secret = body.internal_secret || '';\nconst expected = $env.INTERNAL_EMAIL_SECRET || '';\n\nfunction deny(error, extra) {\n  return { json: Object.assign({\n    valid: false, error: error, tool_name: body.tool_name || '', tool_input: body.tool_input || {}\n  }, extra || {}) };\n}\n\n// 1. Authentication. An unset secret must never mean \"allow\".\nif (!expected || secret !== expected) return deny('internal secret required');\n\nconst toolName = body.tool_name || '';\nconst toolInput = body.tool_input || {};\n\n// 2. Risk class per capability. A tool absent from this table has no declared\n//    risk and is refused -- adding a capability now requires classifying it.\nconst RISK = {\n  place_outbound_call: 'CONTACT_HUMAN',\n  send_whatsapp:       'CONTACT_HUMAN',\n  send_sms:            'CONTACT_HUMAN',\n  send_email:          'CONTACT_HUMAN',\n  book_meeting:        'CONTACT_HUMAN',\n  generate_video:      'WRITE_INTERNAL',\n  update_lead_status:  'WRITE_INTERNAL',\n  log_decision:        'WRITE_INTERNAL',\n  escalate_to_human:   'WRITE_INTERNAL',\n  retrieve_lead_memory:'READ'\n};\n\nif (!toolName) return deny('tool_name required');\nif (!RISK.hasOwnProperty(toolName)) {\n  return deny('unknown tool: ' + toolName + '. Available: ' + Object.keys(RISK).join(', '));\n}\nconst risk = RISK[toolName];\n\n// 3. Tenant context is mandatory for everything that is not pure reasoning.\n//    A caller-supplied client_id is a claim, not proof -- it is checked\n//    against agent_personalities downstream (the executor) and against the\n//    tenant's own rows for direct reads.\nconst client_id = toolInput.client_id || body.client_id || null;\nif (!client_id) {\n  return deny('client_id required: MCP will not execute without tenant context', { risk_class: risk });\n}\n\n// 4. Agent identity and correlation, so an action can be traced back to who\n//    asked for it and which decision it belongs to.\nconst agent_id = body.agent_id || toolInput.agent_id || null;\nconst correlation_id = body.correlation_id || toolInput.decision_id || null;\nif (!agent_id) {\n  return deny('agent_id required', { risk_class: risk });\n}\n\n// 5. Product context. Capabilities belong to products; knowing a tool name\n//    must not be enough to reach another product's surface.\nconst PRODUCT = {\n  place_outbound_call: 'sales_engine', send_whatsapp: 'sales_engine',\n  send_sms: 'sales_engine', send_email: 'sales_engine',\n  book_meeting: 'sales_engine', generate_video: 'sales_engine',\n  update_lead_status: 'sales_engine', log_decision: 'sales_engine',\n  escalate_to_human: 'sales_engine', retrieve_lead_memory: 'sales_engine'\n};\nconst product = PRODUCT[toolName] || null;\nif (!product) return deny('no product mapping for tool', { risk_class: risk });\n\n// 6. Sensitive capabilities are not executed here. They are handed to the\n//    action executor, which applies the autonomy and approval policy. This is\n//    the whole point of the change: MCP cannot be the shorter path.\nconst ROUTED_TO_EXECUTOR = ['place_outbound_call','send_whatsapp','send_sms','send_email','book_meeting'];\nconst ACTION_TYPE = {\n  place_outbound_call: 'voice', send_whatsapp: 'whatsapp',\n  send_sms: 'sms', send_email: 'email', book_meeting: 'book'\n};\n\nreturn { json: {\n  valid: true,\n  tool_name: toolName,\n  tool_input: toolInput,\n  client_id: client_id,\n  agent_id: agent_id,\n  product: product,\n  risk_class: risk,\n  correlation_id: correlation_id,\n  via_executor: ROUTED_TO_EXECUTOR.indexOf(toolName) !== -1,\n  executor_action_type: ACTION_TYPE[toolName] || null,\n  requested_at: new Date().toISOString()\n} };\n",
        "mode": "runOnceForEachItem"
      },

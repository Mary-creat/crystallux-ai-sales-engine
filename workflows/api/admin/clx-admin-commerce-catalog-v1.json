    {
      "parameters": {
        "jsCode": "let rows = $input.all().map(function(i){ return i.json; });\nif (rows.length === 1 && Array.isArray(rows[0])) rows = rows[0];\nrows = rows.filter(function(x){ return x && x.id; });\n// Totals matter more than the list: what is tied up, and what it cost.\nvar onHand = 0, reserved = 0, cost = 0;\nrows.forEach(function(r){\n  onHand += r.quantity_on_hand || 0;\n  reserved += r.quantity_reserved || 0;\n  cost += (r.acquisition_cost_cents || 0) * (r.quantity_on_hand || 0);\n});\nreturn [{ json: { ok: true, status: 200, count: rows.length,\n  units_on_hand: onHand, units_reserved: reserved,\n  units_available: onHand - reserved, stock_cost_cents: cost, items: rows } }];",
        "mode": "runOnceForAllItems"
      },

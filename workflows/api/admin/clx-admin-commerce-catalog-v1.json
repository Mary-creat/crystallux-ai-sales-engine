    {
      "parameters": {
        "jsCode": "let r = $input.item.json;\nif (Array.isArray(r)) r = r[0] || {};\nif (r && r.body !== undefined) r = r.body;\nif (Array.isArray(r)) r = r[0] || {};\nif (!r || typeof r !== 'object') return { json: { ok: false, status: 502, error: 'Unexpected database response' } };\nif (r.ok === false) return { json: r };\nreturn { json: Object.assign({ ok: true, status: 200 }, r) };",
        "mode": "runOnceForEachItem"

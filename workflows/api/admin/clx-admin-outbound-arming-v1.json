    {
      "parameters": {
        "jsCode": "// One shape for both paths, so the dashboard renders the same thing whether\n// it just looked or just flipped the switch.\n//\n// armed is deliberately computed as \"every path armed\", not \"any\". A partial\n// state is not armed -- if one path is paused the answer to 'can this\n// platform contact anyone' is still no for that path, and the button must\n// not claim otherwise.\nconst allOf = function (name) {\n  try {\n    const items = $(name).all().map(function (i) { return i.json; });\n    if (items.length === 1 && Array.isArray(items[0])) return items[0];\n    return items;\n  } catch (e) { return []; }\n};\n\nlet paths = allOf('Read Arming State');\n// The write path returns the RPC's own result; prefer it when present.\nconst wrote = allOf('Flip Switch');\nif (wrote.length && wrote[0] && wrote[0].paths) {\n  paths = wrote[0].paths;\n}\n\nconst clean = (paths || []).filter(function (p) { return p && (p.workflow_id || p.status); })\n  .map(function (p) {\n    return {\n      workflow_id: p.workflow_id,\n      name: p.workflow_name || p.workflow_id,\n      armed: (p.armed === true) || (p.status === 'active') || (p.current_status === 'active'),\n      paused_reason: p.paused_reason || null,\n      updated_at: p.updated_at || null\n    };\n  });\n\nconst armed = clean.length > 0 && clean.every(function (p) { return p.armed; });\n\nreturn { json: {\n  ok: true,\n  armed: armed,\n  partial: clean.some(function (p) { return p.armed; }) && !armed,\n  paths: clean,\n  count: clean.length,\n  checked_at: new Date().toISOString()\n} };\n"
      },
      "id": "oa-0010",
      "name": "Shape Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

      "id": "lsc-0012",
      "name": "Stripe Detach PM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        680
      ],
      "alwaysOutputData": true,
      "notes": "Best effort. Our reference is already gone, so a failure here cannot leave a card that still looks usable to the bidder."
    },
    {
      "parameters": {
        "jsCode": "function res(name){\n  try { const j = $(name).first().json || {}; return { code: j.statusCode || 0, body: j.body }; }\n  catch (e) { return { code: 0, body: null }; }\n}\nfunction unwrap(v){ if (Array.isArray(v)) return v[0] || {}; return v || {}; }\n\nconst x = $('Extract').first().json;\n\nif (x.action === 'status')  return { json: Object.assign({ status: 200 }, unwrap(res('Saved Card RPC').body)) };\nif (x.action === 'forget')  return { json: Object.assign({ status: 200 }, unwrap(res('Forget Card RPC').body)) };\n\nif (x.action === 'confirm') {\n  const si = res('Stripe Get SetupIntent').body || {};\n  if (si.error) return { json: { ok: false, status: 502, error: 'Stripe: ' + (si.error.message || 'lookup failed') } };\n  // The browser tells us it succeeded; Stripe decides whether it did.\n  if (si.status !== 'succeeded') {\n    return { json: { ok: false, status: 402,\n      error: 'Card setup did not complete (status: ' + si.status + ').' } };\n  }\n  const saved = unwrap(res('Record Card RPC').body);\n  if (saved.ok === false) return { json: saved };\n  return { json: { ok: true, status: 200, saved: true } };\n}\n\n// start\nconst cust = res('Stripe Ensure Customer').body || {};\nconst si   = res('Stripe Create SetupIntent').body || {};\nif (si.error) return { json: { ok: false, status: 502, error: 'Stripe: ' + (si.error.message || 'setup failed') } };\nif (!si.client_secret) return { json: { ok: false, status: 502,\n  error: 'Stripe did not return a SetupIntent (is STRIPE_SECRET_KEY set?)' } };\nreturn { json: { ok: true, status: 200,\n  setup_intent_id: si.id,\n  client_secret: si.client_secret,\n  stripe_pk: $env.STRIPE_PUBLISHABLE_KEY || '' } };",
        "mode": "runOnceForEachItem"
      },
      "id": "lsc-0013",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        400
      ]

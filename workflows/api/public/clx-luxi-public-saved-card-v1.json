        200,
        400
      ],
      "webhookId": "clx-luxi-public-saved-card-001",
      "notes": "DEACTIVATED. Public. action=status|start|confirm|forget. Saves a card once via SetupIntent so a bidder does not re-enter it every lot. Returns no Stripe identifiers beyond the client_secret Elements requires."
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || {};\nconst action = String(body.action || 'status').toLowerCase().trim();\nif (['status','start','confirm','forget'].indexOf(action) === -1) {\n  return { json: { ok: false, status: 400, error: 'unknown action' } };\n}\nconst handle = String(body.handle || body.email || body.name || '').trim().slice(0, 120);\nif (!handle) return { json: { ok: false, status: 400, error: 'name or email required' } };\n// A saved card is only offered to someone who gave an email. A display name\n// is not an identity, and attaching a stored card to \"Dave\" would hand the\n// next Dave someone else's card.\nif (action !== 'status' && handle.indexOf('@') === -1) {\n  return { json: { ok: false, status: 400,\n    error: 'An email address is required to save a card for next time.' } };\n}\nreturn { json: {\n  action: action,\n  handle: handle,\n  setup_intent_id: String(body.setup_intent_id || '').trim(),\n  consent: body.consent === true\n} };",
        "mode": "runOnceForEachItem"
      },
      "id": "lsc-0002",
      "name": "Extract",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "status",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "status",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "start",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "start",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "confirm",

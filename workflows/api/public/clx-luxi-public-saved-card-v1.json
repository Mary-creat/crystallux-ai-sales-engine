        "jsonBody": "={{ JSON.stringify({ p_handle: $('Extract').first().json.handle, p_payment_method_id: (($('Stripe Get SetupIntent').first().json.body || {}).payment_method) || null, p_brand: ((($json.body || {}).card) || {}).brand || null, p_last4: ((($json.body || {}).card) || {}).last4 || null, p_exp_month: ((($json.body || {}).card) || {}).exp_month || null, p_exp_year: ((($json.body || {}).card) || {}).exp_year || null, p_consent_text: \"I authorise Crystallux to save this card and to charge it for auctions I win, including when I am not on the site.\" }) }}",
        "options": {

    },
    {
      "parameters": {
        "method": "usage=off_session is what makes the saved card chargeable later without the bidder present. Consent is recorded separately on confirm.",
        "url": "https://api.stripe.com/v1/setup_intents",
        "sendHeaders": true,
        "headerParameters": {

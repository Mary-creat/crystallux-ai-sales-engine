            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ 'customer=' + encodeURIComponent((($('Attach Customer RPC').first().json.body || [{}])[0] || {}).customer_id || '') + '&usage=off_session&automatic_payment_methods[enabled]=true' + '&metadata[handle]=' + encodeURIComponent($('Extract').first().json.handle) }}"
      },
      "id": "lsc-0007",
      "name": "Stripe Create SetupIntent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        340
      ],
      "alwaysOutputData": true,
      "notes": ""
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.stripe.com/v1/setup_intents/' + $json.setup_intent_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.STRIPE_SECRET_KEY }}"

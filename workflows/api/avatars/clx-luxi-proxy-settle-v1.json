{
  "id": "wfLuxiProxySettleV1",
  "name": "CLX - LUXI Proxy Settle v1",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "id": "lps-0001",
      "name": "Schedule (every 1 min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zqwatouqmqgkmaslydbr.supabase.co/rest/v1/rpc/luxi_claim_proxy_settlements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"p_limit\": 100 }",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "lps-0002",
      "name": "Claim Settlements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        400
      ],
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Crystallux Custom"
        }
      },
      "alwaysOutputData": true,
      "notes": "Atomic claim: flips each row to 'settling' inside the same statement that returns it, so a slow run cannot be lapped by the next one and capture the same hold twice."
    },
    {
      "parameters": {
        "jsCode": "let rows = $input.item.json;\nif (!Array.isArray(rows)) rows = (rows && rows.proxy_id) ? [rows] : [];\nif (rows.length === 0) return [{ json: { _no_work: true, ts: new Date().toISOString() } }];\nreturn rows.filter(function (r) { return r && r.proxy_id && r.stripe_payment_intent_id; }).map(function (r) { return { json: r }; });",
        "mode": "runOnceForAllItems"
      },
      "id": "lps-0003",
      "name": "Fan Out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        400
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json._no_work }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "lps-0004",
      "name": "IF Has Work",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        900,
        400
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "capture",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "capture",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "release",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "c1",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "release",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "lps-0005",
      "name": "Capture or Release",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1120,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.stripe.com/v1/payment_intents/' + $json.stripe_payment_intent_id + '/capture' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.STRIPE_SECRET_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "={{ 'amount_to_capture=' + $json.amount_cents }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "lps-0006",
      "name": "Stripe Capture",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.stripe.com/v1/payment_intents/' + $json.stripe_payment_intent_id + '/cancel' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.STRIPE_SECRET_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/x-www-form-urlencoded"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "string",
        "body": "cancellation_reason=abandoned",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "lps-0007",
      "name": "Stripe Cancel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1360,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Translate the Stripe response into arguments for luxi_settle_proxy_result,\n// which records the outcome AND -- on a successful capture -- creates the\n// order and moves the stock, in one transaction.\nconst stripe = $input.item.json || {};\nconst src = $('Fan Out').itemMatching($itemIndex).json;\nconst st = stripe.status || null;\nconst err = stripe.error ? (stripe.error.message || stripe.error.code) : null;\n\nlet succeeded;\nif (src.action === 'capture') succeeded = (st === 'succeeded');\nelse succeeded = (st === 'canceled');\n\nreturn { json: {\n  p_proxy_id: src.proxy_id,\n  p_action: src.action,\n  p_succeeded: succeeded,\n  p_amount_cents: src.amount_cents,\n  p_error: succeeded ? null : (err || ('unexpected status: ' + st))\n} };",
        "mode": "runOnceForEachItem"
      },
      "id": "lps-0008",
      "name": "Record Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        400
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zqwatouqmqgkmaslydbr.supabase.co/rest/v1/rpc/luxi_requeue_stuck_settlements",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "lps-0012",
      "name": "Requeue Stuck",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        560
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Crystallux Custom"
        }
      },
      "notes": "A run that dies mid-settle leaves rows in 'settling' forever. This returns anything stuck over 15 minutes so it retries."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://zqwatouqmqgkmaslydbr.supabase.co/rest/v1/rpc/luxi_settle_proxy_result",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "lps-0011",
      "name": "Settle Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1840,
        400
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpCustomAuth": {
          "name": "Supabase Crystallux Custom"
        }
      },
      "notes": "Records capture/release AND creates the order + inventory movement in one transaction, so a captured payment and its order can never be half-written."
    }
  ],
  "connections": {
    "Schedule (every 1 min)": {
      "main": [
        [
          {
            "node": "Requeue Stuck",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Requeue Stuck": {
      "main": [
        [
          {
            "node": "Claim Settlements",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Settlements": {
      "main": [
        [
          {
            "node": "Fan Out",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fan Out": {
      "main": [
        [
          {
            "node": "IF Has Work",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Has Work": {
      "main": [
        [
          {
            "node": "Capture or Release",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Capture or Release": {
      "main": [
        [
          {
            "node": "Stripe Capture",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stripe Cancel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stripe Capture": {
      "main": [
        [
          {
            "node": "Record Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stripe Cancel": {
      "main": [
        [
          {
            "node": "Record Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Result": {
      "main": [
        [
          {
            "node": "Settle Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}

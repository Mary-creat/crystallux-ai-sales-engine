# Cloudflare Pages security headers for app.crystallux.org
# Client-facing dashboard. Tighter than the marketing site — no
# third-party scripts allowed; only n8n is reachable from the browser.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://*.cloudflareinsights.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://automation.crystallux.org https://cloudflareinsights.com https://*.cloudflareinsights.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; upgrade-insecure-requests;
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-Robots-Tag: noindex, nofollow

# Long-cache the immutable shared assets — they're versioned by the
# git commit so cache hit rate stays high.
/shared/*
  # auth.js gates every page. At max-age=86400 a fix to it took 24 hours to
  # reach anyone, and Cloudflare served a stale copy the whole time -- which
  # is how a corrected redirect loop kept looping after the fix shipped.
  #
  # max-age=0 with must-revalidate does NOT mean "download every time": the
  # ETag makes the check a 304 with no body. The cost is one conditional
  # request; the benefit is that a security or access fix is live the moment
  # it deploys. For the file that decides who gets in, that is the right
  # trade.
  Cache-Control: public, max-age=0, must-revalidate

# Pages must always re-validate so a deploy reaches users on next
# load instead of waiting for cache TTL.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
